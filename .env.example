# Application Environment
ENVIRONMENT=development
DEBUG=true

# Security & Session Settings
# Generate a secure key in production with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-secret
COOKIE_SECURE=false
SESSION_EXPIRE_HOURS=24

# Database
DATABASE_URL=sqlite:///./grocery.db

# Admin Initial Credentials (Used on initial seed / admin authentication)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@freshmart.local
ADMIN_PASSWORD=replace-with-a-secure-password
